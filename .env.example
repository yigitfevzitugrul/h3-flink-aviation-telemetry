# Veri kaynağı: sim (sentetik) | opensky (gerçek)
MODE=sim

# OpenSky Network API kimlik bilgileri (opsiyonel; boşsa anonim erişim, düşük kota)
# https://opensky-network.org -> Account -> API Client
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# İlgi alanı (Türkiye): lamin,lomin,lamax,lomax
BBOX=35.8,25.6,42.2,44.8

POSTGRES_DB=telemetry
POSTGRES_USER=telemetry
POSTGRES_PASSWORD=telemetry
